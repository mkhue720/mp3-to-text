# Model Whisper: tiny | base | small | medium | large-v3
WHISPER_MODEL=base

# cpu hoặc cuda (nếu có GPU NVIDIA + CUDA)
WHISPER_DEVICE=cuda

# int8 (CPU, nhanh) | float16 (GPU) | float32
WHISPER_COMPUTE=float16

# Giới hạn upload (MB)
MAX_UPLOAD_MB=50

# Server
HOST=0.0.0.0
PORT=8000

# Tự dịch sau convert (để trống = tắt). VD: en, vi, ja
AUTO_TRANSLATE_TARGET=
